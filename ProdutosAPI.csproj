<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProdutosAPI</RootNamespace>
    <AssemblyName>ProdutosAPI</AssemblyName>
    <Version>2.0.0</Version>
    <Description>API REST de Produtos com Minimal API e .NET 10</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test projects from main build -->
    <Compile Remove="tests/ProdutosAPI.Tests/**" />
    <Compile Remove="tests/Pedidos.Tests/**" />
    <Compile Remove="tests/Pix.MockServer.Tests/**" />
    <!-- Exclude new sub-projects (compiled separately, referenced via ProjectReference) -->
    <Compile Remove="src/Produtos/**" />
    <Compile Remove="src/Catalogo/Catalogo.Domain/**" />
    <Compile Remove="src/Catalogo/Catalogo.Application/**" />
    <Compile Remove="src/Catalogo/Catalogo.Infrastructure/**" />
    <Compile Remove="src/Catalogo/Catalogo.API/**" />
    <Compile Remove="src/Catalogo/Catalogo.ClientDemo/**" />
    <Compile Remove="src/Pix/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/Catalogo/Catalogo.API/Catalogo.API.csproj" />
    <ProjectReference Include="src/Catalogo/Catalogo.Infrastructure/Catalogo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Documentação OpenAPI/Swagger -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    
    <!-- Validação de dados -->
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    
    <!-- ORM para banco de dados -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SQLite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- Logging estruturado -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    
    <!-- Autenticação JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    
    <!-- Mapeamento de objetos -->
    <PackageReference Include="AutoMapper" Version="16.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude development and documentation files from being copied to test bins -->
    <Content Remove="src/**" />
    <Content Remove="tests/**" />
    <Content Remove="docs/**" />
    <Content Remove="examples/**" />
    <Content Remove="plans/**" />
    <Content Remove="superpowers/**" />
    <Content Remove="CLAUDE.md" />
    <Content Remove="README.md" />
    <Content Remove="setup.sh" />
    <Content Remove="dotnet-tools.json" />
    <Content Remove="ProdutosAPI.slnx" />
    <None Remove="src/**" />
    <None Remove="tests/**" />
    <None Remove="docs/**" />
    <None Remove="examples/**" />
    <None Remove="plans/**" />
    <None Remove="superpowers/**" />
    <None Remove="CLAUDE.md" />
    <None Remove="README.md" />
    <None Remove="setup.sh" />
    <None Remove="dotnet-tools.json" />
    <None Remove="ProdutosAPI.slnx" />
  </ItemGroup>

</Project>
